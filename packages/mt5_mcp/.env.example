# ==============================================================================
# MetaTrader 5 FastMCP Environment Configuration (Template)
# ==============================================================================
# Copy this to .env and configure your portable worker paths.
# Never commit your real credentials or local paths.

# --- MCP Transport ---
# Use "stdio" for AI Agent orchestrators, or "http" for web testing
MT5_MCP_TRANSPORT=stdio
MT5_MCP_HOST=127.0.0.1
MT5_MCP_PORT=8000

# --- Portable MetaTrader 5 Terminal Paths ---
# All user data, expert advisors, and tick bases live inside your portable folder.
MT5_PATH="C:\\MetaTrader5_Portable\\terminal64.exe"
MT5_METAEDITOR_PATH="C:\\MetaTrader5_Portable\\MetaEditor64.exe"
MT5_DATA_FOLDER="C:\\MetaTrader5_Portable"
MT5_CONFIG_FOLDER="C:\\MetaTrader5_Portable\\Config"
MT5_TESTER_LOG="C:\\MetaTrader5_Portable\\Tester\\logs"
MT5_TERMINAL_INI="C:\\MetaTrader5_Portable\\Config\\terminal.ini"
MT5_COMMON_INI="C:\\MetaTrader5_Portable\\Config\\common.ini"

# --- Demo Account Credentials (BYOB - Bring Your Own Broker) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=YourBroker-Demo
MT5_AUTO_LOGIN=true
