# MT5-MCP Environment Configuration
# ─────────────────────────────────
# Copy this to .env in the repo root and fill in your own values.
# Never commit the real .env file — only this .env.example.

# ─── MCP Transport ─────────────────────────────────────────
# Use "stdio" for MCP clients (Hermes plugin, Codex CLI, Claude Desktop, Cursor)
# Use "http" for development/testing with a web browser
MT5_MCP_TRANSPORT=stdio

# HTTP Transport Settings (only used when MT5_MCP_TRANSPORT=http)
MT5_MCP_HOST=127.0.0.1
MT5_MCP_PORT=8000

# ─── MetaTrader 5 Paths ────────────────────────────────────
# Demo Broker PORTABLE install — all data (accounts.dat,
# servers.dat, terminal.lic, MQL5) lives INSIDE this folder.
# No writes to %APPDATA%\MetaQuotes whatsoever.
MT5_PATH="C:\\AI\\MetaTrader5_Portable\\terminal64.exe"
MT5_METAEDITOR_PATH="C:\\AI\\MetaTrader5_Portable\\MetaEditor64.exe"

# ─── MT5 Data Folder (portable) ────────────────────────────
# With /portable, the MetaTrader5 Python package uses this folder.
# This MUST match your portable MT5 directory.
MT5_DATA_FOLDER="C:\\AI\\MetaTrader5_Portable"
MT5_CONFIG_FOLDER="C:\\AI\\MetaTrader5_Portable\\Config"
MT5_TESTER_LOG="C:\\AI\\MetaTrader5_Portable\\Tester\\logs"
MT5_TERMINAL_INI="C:\\AI\\MetaTrader5_Portable\\Config\\terminal.ini"
MT5_COMMON_INI="C:\\AI\\MetaTrader5_Portable\\Config\\common.ini"

# ─── Demo Account Login (Portable Broker) ────────────────────────
# The portable accounts.dat already has these saved (login persists).
# These are used for auto-login via _auto_login_if_needed() if the
# terminal starts unauthenticated.
#   Account : 12345678 (YourBroker-Demo)
#   Server  : YourBroker-Demo
#   Password: your MT5 demo account password (NOT investor pw)
MT5_LOGIN=12345678
MT5_PASSWORD=[your-password]
MT5_SERVER=YourBroker-Demo

# ─── Auto-Login ─────────────────────────────────────────────
# If true, initialize() calls login() automatically after connecting.
MT5_AUTO_LOGIN=true

# ─── MetaTrader5 Python Package ─────────────────────────────
# Required: MetaTrader5 Python package matching your MT5 build.
# Install via:  uv add metatrader5==5.0.5735
# Or:           pip install MetaTrader5==5.0.5735
# The version must match your MT5 terminal build for full compatibility.
