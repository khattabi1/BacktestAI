# MT5-MCP Environment Configuration
# ─────────────────────────────────
# Copy this to .env in the repo root and fill in your own values.
# Never commit the real .env file — only this .env.example.

# ─── MCP Transport ─────────────────────────────────────────
# Use "stdio" for MCP clients (Claude Desktop, Cursor, etc.)
# Use "http" for development/testing with a web browser
MT5_MCP_TRANSPORT=stdio

# HTTP Transport Settings (only used when MT5_MCP_TRANSPORT=http)
MT5_MCP_HOST=127.0.0.1
MT5_MCP_PORT=8000

# ─── MetaTrader 5 Paths ────────────────────────────────────
# Path to your MT5 terminal64.exe
# Ask the user: "Where is your MetaTrader 5 installed?"
# Common locations:
#   C:\Program Files\MetaTrader 5\terminal64.exe
#   C:\Program Files\MetaTrader 5 Demo Broker\terminal64.exe
#   C:\Program Files\MetaTrader 5 Portable Broker Limited\terminal64.exe
MT5_PATH="C:\Program Files\MetaTrader 5 Demo Broker\terminal64.exe"

# Path to MetaEditor64.exe (for compiling .mq5 → .ex5)
MT5_METAEDITOR_PATH="C:\Program Files\MetaTrader 5 Demo Broker\MetaEditor64.exe"

# ─── MT5 Data Folder ───────────────────────────────────────
# This is the terminal data folder (contains MQL5, Config, Tester, Logs)
# To find it: File → Open Data Folder in MT5, or check:
#   C:\Users\[username]\AppData\Roaming\MetaQuotes\Terminal\[terminal-hash]\
# The [terminal-hash] is a 32-character hex string unique to each MT5 instance.
# You can have multiple terminal hashes if you installed MT5 multiple times.

# Portable Broker default (most common for demo accounts):
MT5_DATA_FOLDER="C:\MetaTrader5_Portable"

# Config folder (where tester config .ini files go)
MT5_CONFIG_FOLDER="C:\MetaTrader5_Portable\Config"

# Tester logs folder (UTF-16-LE encoded .log files)
MT5_TESTER_LOG="C:\MetaTrader5_Portable\Tester\logs"

# Path to terminal.ini (binary UTF-16-LE, [Tester] section holds date range)
MT5_TERMINAL_INI="C:\MetaTrader5_Portable\Config\terminal.ini"

# ─── Demo Account Login (for Portable Broker) ─────────────────────
# To find your account number:
#   1. Open MT5 → Ctrl+R (or click the account in the top toolbar)
#   2. Copy the account number
# To find your server name:
#   1. Open MT5 → Tools → Options → Server tab
#   2. Copy the server name (e.g. "YourBroker-Demo")
# The password is your MT5 trade account password (NOT the investor password).
MT5_LOGIN=[your-account-number]
MT5_PASSWORD=[your-password]
MT5_SERVER=YourBroker-Demo

# ─── MetaTrader5 Python Package ─────────────────────────────
# Required: metatrader5 Python package matching your MT5 build.
# Install via:  uv add metatrader5==5.0.5735
# Or:           pip install MetaTrader5==5.0.5735
# The version must match your MT5 terminal build for full compatibility.
