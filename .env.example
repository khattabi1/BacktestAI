# ==============================================================================
# Backtest AI Environment Configuration (Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Model API (Official Cloud - Hackathon Flagship)
# ------------------------------------------------------------------------------
META_MODEL_API_KEY=your_meta_model_api_key_here
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_PLANNER=muse-wonder
META_MODEL_EXECUTOR=muse-spark-1.3-contributor
META_MODEL_VOICE=muse-voice-transcribe

# Active LLM Provider
LLM_PROVIDER=meta

# ------------------------------------------------------------------------------
# 2. Authentication & Security
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ------------------------------------------------------------------------------
# 3. Distributed Task Queue (ARQ + Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. Quantitative Web Research & Market Intelligence
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here

# ------------------------------------------------------------------------------
# 5. Database Configuration (PostgreSQL Unified)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://bt_user:YOUR_PASSWORD_HERE@localhost:5432/backtest_ai
SYNC_DATABASE_URL=postgresql://bt_user:YOUR_PASSWORD_HERE@localhost:5432/backtest_ai
