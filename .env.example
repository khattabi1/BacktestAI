# ==============================================================================
# Backtest AI Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Model API (Official Cloud - Hackathon Flagship)
# ------------------------------------------------------------------------------
META_MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL_PLANNER=muse-wonder
META_MODEL_EXECUTOR=muse-spark-1.3
META_MODEL_VOICE=muse-voice-transcribe

# Active LLM Provider (meta | gemini | freeinference | agentrouter)
LLM_PROVIDER=meta

# ------------------------------------------------------------------------------
# 2. Alternative LLM Providers (Fallbacks)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

FREEINFERENCE_API_KEY=your_freeinference_key_here
FREEINFERENCE_BASE_URL=https://freeinference.org/v1
FREEINFERENCE_MODEL=deepseek-v4-flash

AGENTROUTER_API_KEY=your_agentrouter_key_here
AGENTROUTER_MODEL=deepseek-v4-flash
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ------------------------------------------------------------------------------
# 3. Google OAuth & Auth Authentication
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
JWT_SECRET=backtest-ai-super-secret-jwt-key-2026-quant-secure

# ------------------------------------------------------------------------------
# 4. Distributed Task Queue (ARQ + Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 5. Quantitative Web Research & Market Intelligence
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
